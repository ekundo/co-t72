/* Диагностическая правка драйвера квазидиска МикроДОС T-72, в ОЗУ.
 *
 * Лекарством она быть не может: README самой T-72 говорит, что оба квазидиска
 * одновременно не работают, и поэтому буфер обмена с D: не должен попадать в
 * 0A000h..0DFFFh. Правка нужна, чтобы отделить «буфер в окне» от всего
 * остального: с ней обмен с D: идёт из любого буфера.
 *
 * Обе ветки обмена начинаются с "XRA A / OUT 010h" -- гасят первый квазидиск
 * целиком, вместе с окном ОЗУ A000-DFFF. Для C: окно возвращает следующий же
 * OUT с конфигом, для D: конфиг уходит в порт 011h и окно остаётся выключенным
 * всю пересылку. Убираем эти три байта: на выходе драйвер и так оставляет в
 * порту 010h значение 023h. Адреса у сборок f/h/hx/k разные, ищем по образцу.
 */
def kd_patch() {
    var n = 0
    for (var a = 0xE200; a < 0xE600; ++a) {
        if (read_memory(a,0)==0xAF && read_memory(a+1,0)==0xD3 && read_memory(a+2,0)==0x10 &&
            read_memory(a+3,0)==0x3A && read_memory(a+6,0)==0xC6 && read_memory(a+7,0)==0x0E &&
            read_memory(a+8,0)==0x32) {
            write_memory(a,0,0); write_memory(a+1,0,0); write_memory(a+2,0,0); ++n
        }
    }
    var v = VectorInt(); v.push_back(n); write_file("kd2-patch.bin", v)
}
