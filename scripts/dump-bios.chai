/* Снять адрес дискового обработчика из таблицы переходов БСВВ.
 *
 * Читать сразу после загрузки нельзя: в таблице по E212 стоит не сам
 * обработчик, а заглушка (`L_E2E4: XRA A / RET` -- хвост ветки квазидиска),
 * и настоящий адрес ОС прописывает туда сама при первом обращении к диску
 * (`L_E224: LXI H,L_E2C4 / SHLD L_E212+1`). У сборки без НЖМД разницы не
 * видно -- там уже с самого начала стоит рабочий адрес, -- а у h и hx до
 * подмены читается E3E1, и CO с ним получает пустые каталоги.
 *
 * Поэтому сначала заставляем ССР полезть на диск (набираем несуществующую
 * команду -- он ищет её в каталоге), и только потом читаем таблицу.
 *
 * УС держим с нулевого кадра, иначе загрузчик падает на неинициализированном
 * квазидиске.
 */
global us = scancode_from_name("Left Ctrl")

def framefunc(frameno) {
    if (frameno == 0)   { keydown(us) }
    if (frameno == 90)  { keyup(us) }
    if (frameno == 400) { keytyper.types([60, "X", 25, "Y", 25, "Z", 25, "Return", 200]) }
    if (frameno == 1100) {
        var v = VectorInt()
        var i = 0
        while (i < 0x20) { v.push_back(read_memory(0xE200 + i, 0)); i = i + 1 }
        write_file("bios-vectors.bin", v)
    }
    keytyper.onframe()
}
add_callback("frame", framefunc)
